# Public business discovery
GOOGLE_MAPS_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Research providers
FIRECRAWL_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=

# Optional owner-authorized platform connections
META_APP_ID=
META_APP_SECRET=
YOUTUBE_API_KEY=

# Persistence and workers
DATABASE_URL=
REDIS_URL=

# Q Intelligence operational store
# Uses local SQLite by default. Use an absolute path in managed environments.
Q_INTELLIGENCE_DB_PATH=data/q-intelligence.sqlite
Q_INTELLIGENCE_TIMEZONE=America/Toronto
Q_INTELLIGENCE_DAILY_TARGET=10

# Workspace authorization
# Set to "required" outside a trusted localhost development session.
Q_INTELLIGENCE_AUTH_MODE=required
Q_INTELLIGENCE_SESSION_SECRET=
Q_INTELLIGENCE_ADMIN_TOKEN=
Q_INTELLIGENCE_SENDER_TOKEN=
Q_INTELLIGENCE_RESEARCHER_TOKEN=
Q_INTELLIGENCE_VIEWER_TOKEN=
Q_INTELLIGENCE_INTERNAL_API_TOKEN=

# Instantly API v2 (server-side only; never prefix these with NEXT_PUBLIC_)
INSTANTLY_API_KEY=
# Optional alternative: point to an external dotenv file and select one variable.
# Leave INSTANTLY_API_KEY empty when using this mode.
INSTANTLY_API_KEY_FILE=
INSTANTLY_API_KEY_FILE_VARIABLE=INSTANTLY_API_KEY
INSTANTLY_APPROVED_SENDER_ACCOUNTS=
INSTANTLY_APPROVED_CAMPAIGN_IDS=
INSTANTLY_MIN_WARMUP_SCORE=75
INSTANTLY_WEBHOOK_SECRET=
